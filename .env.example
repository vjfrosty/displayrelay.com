# Copy this file to .env.local before running the stack.

# Database
DATABASE_URL="postgresql://display_platform:display_platform@postgres:5432/display_platform"

# Redis
REDIS_URL="redis://redis:6379"

# Soketi
SOKETI_HOST="localhost"
SOKETI_PORT="6001"
SOKETI_APP_ID="display-platform"
SOKETI_APP_KEY="display-platform-key"
SOKETI_APP_SECRET="display-platform-secret"

# Auth
NEXTAUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost"
BCRYPT_ROUNDS=12
SUPER_ADMIN_EMAIL="admin@your-domain.com"

# AI — OpenRouter
OPENROUTER_API_KEY="sk-or-v1-..."

# Image Providers
PEXELS_API_KEY="your-pexels-key"
PIXABAY_API_KEY="your-pixabay-key"
OPENVERSE_API_KEY=""

# Google
GOOGLE_SERVICE_ACCOUNT_EMAIL="service@project.iam.gserviceaccount.com"
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n..."
GOOGLE_CALENDAR_WEBHOOK_SECRET="random-token"
GOOGLE_PLACES_API_KEY="AIza..."

# Weather
OPENWEATHERMAP_API_KEY="your-owm-key"

# MinIO
MINIO_ENDPOINT="http://minio:9000"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin123"
MINIO_BUCKET="display-platform-assets"
MINIO_PUBLIC_URL="http://localhost/assets"

# App
NEXT_PUBLIC_APP_URL="http://localhost"
NEXT_PUBLIC_SOKETI_HOST="localhost"
NEXT_PUBLIC_SOKETI_KEY="display-platform-key"

# Stripe
STRIPE_SECRET_KEY="sk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_STARTER_PRICE_ID="price_..."
STRIPE_PRO_PRICE_ID="price_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_live_..."

# Pairing
PAIRING_CODE_TTL_SECONDS=300